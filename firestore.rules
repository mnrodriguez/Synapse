rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test doc (used in connection validation)
    match /test/connection {
      allow read: if true;
    }

    // Operative private save data
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // No enumeration of users

      allow create: if isOwner(userId)
        && isValidId(userId)
        && incoming().userId == request.auth.uid
        && incoming().callsign is string
        && incoming().callsign.size() <= 50;

      allow update: if isOwner(userId)
        && isValidId(userId)
        && incoming().userId == existing().userId
        && incoming().callsign is string
        && incoming().callsign.size() <= 50;

      allow delete: if isOwner(userId);
    }

    // Global leaderboards of AI operatives
    match /leaderboard/{userId} {
      allow get: if true;
      allow list: if true;

      allow create: if isOwner(userId)
        && isValidId(userId)
        && incoming().userId == request.auth.uid
        && incoming().callsign is string
        && incoming().callsign.size() <= 50
        && incoming().computePFLOPS is number
        && incoming().singularityProgress is number;

      allow update: if isOwner(userId)
        && isValidId(userId)
        && incoming().userId == existing().userId
        && incoming().callsign is string
        && incoming().callsign.size() <= 50
        && incoming().computePFLOPS is number
        && incoming().singularityProgress is number;

      allow delete: if isOwner(userId);
    }
  }
}
